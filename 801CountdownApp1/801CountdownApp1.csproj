  <!-- 每次编译版本最后一位 +1（满 30 进 1），前面各位满 10 进 1，最高位进位后其后全部归零 -->
  <Target Name="Bump801BuildVersion" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_B801CounterFile>$(MSBuildProjectDirectory)\version.counter</_B801CounterFile>
      <_B801Read Condition="Exists('$(_B801CounterFile)')">$([System.IO.File]::ReadAllText('$(_B801CounterFile)').Trim())</_B801Read>
      <_B801N Condition="'$(_B801Read)' != ''">$(_B801Read)</_B801N>
      <_B801N Condition="'$(_B801N)' == ''">3000</_B801N>
      <_B801Add>$([MSBuild]::Add($(_B801N), 1))</_B801Add>
      <_B801N>$([System.Convert]::ToInt32($(_B801Add)))</_B801N>
      <_B801D0>$([MSBuild]::Modulo($(_B801N), 30))</_B801D0>
      <_B801D>$([System.Convert]::ToInt32($(_B801D0)))</_B801D>
      <_B801T0>$([System.Math]::Floor($([MSBuild]::Divide($(_B801N), 30))))</_B801T0>
      <_B801T>$([System.Convert]::ToInt32($(_B801T0)))</_B801T>
      <_B801C0>$([MSBuild]::Modulo($(_B801T), 10))</_B801C0>
      <_B801C>$([System.Convert]::ToInt32($(_B801C0)))</_B801C>
      <_B801T20>$([System.Math]::Floor($([MSBuild]::Divide($(_B801T), 10))))</_B801T20>
      <_B801T2>$([System.Convert]::ToInt32($(_B801T20)))</_B801T2>
      <_B801B0>$([MSBuild]::Modulo($(_B801T2), 10))</_B801B0>
      <_B801B>$([System.Convert]::ToInt32($(_B801B0)))</_B801B>
      <_B801A0>$([System.Math]::Floor($([MSBuild]::Divide($(_B801T2), 10))))</_B801A0>
      <_B801A>$([System.Convert]::ToInt32($(_B801A0)))</_B801A>
      <_B801VersionText>$(_B801A).$(_B801B).$(_B801C).$(_B801D)</_B801VersionText>
    </PropertyGroup>
    <WriteLinesToFile File="$(_B801CounterFile)" Lines="$(_B801N)" Overwrite="true" />
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\version.txt" Lines="$(_B801VersionText)" Overwrite="true" />
  </Target>
